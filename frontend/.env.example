# Server-Side API URL
# Used by Express local server (server.js) and Vercel Serverless Function (api/ssr.js)
API_URL=https://backend-one-rho-24.vercel.app/api

# Client-Side API URL
# Bundled by Vite into client code (must have VITE_ prefix)
VITE_API_URL=https://backend-one-rho-24.vercel.app/api
VITE_BACKEND_URL=https://backend-one-rho-24.vercel.app/api

