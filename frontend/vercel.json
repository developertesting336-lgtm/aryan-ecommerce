{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/" }
  ]
}


{
  "outputDirectory": "dist/client",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/ssr" }],
  "functions": {
    "api/ssr.js": { "includeFiles": "dist/server/**" }
  }
}
