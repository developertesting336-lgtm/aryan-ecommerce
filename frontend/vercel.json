{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/ssr.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*\\.(?:ico|png|jpg|jpeg|webp|avif|svg|jfif|css|js|json|woff2?|ttf|txt|xml))",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/ssr?__p=/$1"
    }
  ]
}