{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/ssr.js": {
      "includeFiles": "dist/**",
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*\\.(?:ico|png|jpg|jpeg|webp|avif|svg|jfif|css|js|json|woff2?|ttf|txt|xml))",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/ssr?__p=/$1"
    }
  ]
}
